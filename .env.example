NEXT_PUBLIC_SITE_URL=http://localhost:3000
POSTGRES_URL=postgres://user:password@localhost:5432/mybento

# Better Auth
BETTER_AUTH_SECRET=your_super_secret_random_string_generate_with_cli
BETTER_AUTH_URL=http://localhost:3000
# For production, use your actual domain:
# BETTER_AUTH_URL=https://yourdomain.com

# Optional: Site branding
NEXT_PUBLIC_SITE_NAME=mybento
NEXT_PUBLIC_SITE_DESCRIPTION=A place for all your links, social media, and content.

# Optional: Community mode
# When true: Open registration for multiple users (community/multi-user mode)
# When false or not set: Single user mode - registration closes after first user, homepage shows user page
COMMUNITY_MODE=false

# Optional: Cloudflare R2 for image uploads
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=mybento
# R2_PUBLIC_URL=https://your-public-domain.com

# Optional: Email verification with Resend
# If both RESEND_API_KEY and EMAIL_FROM are set, email verification will be enabled
# Users will need to verify their email before they can log in
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=noreply@yourdomain.com

# Optional: Trusted origins for CSRF protection (comma-separated)
# TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
